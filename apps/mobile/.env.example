# Flutter does NOT read .env files directly.
# All environment values are passed at build/run time via --dart-define.
# This file documents the variable names and recommended values for each
# environment so developers know what to pass.
#
# Read in code via String.fromEnvironment(...) — see lib/core/env/app_env.dart.
#
# Local development (Android emulator):
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000 --dart-define=APP_ENV=development
#
# Local development (physical device on same Wi-Fi):
#   flutter run --dart-define=API_BASE_URL=http://<your-mac-LAN-ip>:3000 --dart-define=APP_ENV=development
#
# Production (release APK):
#   flutter build apk --release --dart-define=API_BASE_URL=https://api.roteirizadorpro.com.br --dart-define=APP_ENV=production

API_BASE_URL=http://10.0.2.2:3000
APP_ENV=development
