# Flutter pode ler este arquivo via `--dart-define-from-file=.env`.
# Todos os valores aqui são consumidos no código Dart via
# String.fromEnvironment(...) — ver lib/core/env/app_env.dart.
#
# Copie este arquivo pra `.env` e preencha com os valores reais do seu
# ambiente. `.env` é gitignored — nunca commitar segredos.
#
# Uso recomendado:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --debug --target-platform android-arm64 \
#     --dart-define-from-file=.env
#
# Build de release assinado pra distribuição:
#   bash scripts/build-release-apk.sh
# (o script já envolve --dart-define-from-file=.env + assinatura + split-per-abi)

# Backend base URL (slice 1 endpoint canônico).
# - Emulator Android: http://10.0.2.2:3000
# - Device físico na mesma Wi-Fi: http://<seu-ip-local>:3000
# - Prod: https://api.roteirizadorpro.com.br
API_BASE_URL=https://api.roteirizadorpro.com.br

# `production` ou `development`. Afeta AppEnv.isProduction
# (verbosidade de log, analytics opt-out, etc).
APP_ENV=production

# Google Maps SDK key. Lido pelo plugin Android
# (`<meta-data android:name="com.google.android.geo.API_KEY">`) e
# também por AppEnv.mapsApiKey se precisar em código Dart.
# Sem essa key o widget GoogleMap renderiza tela em branco.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE
