{
  "name": "@roteirizador/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Roteirizador Pro backend API (Fastify v5 + TypeBox + Prisma 7).",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.9 <21"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/type-provider-typebox": "^6.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sinclair/typebox": "^0.34.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
