{
  "name": "roteirizador-pro",
  "version": "0.0.0",
  "private": true,
  "description": "Repo-root tooling (lefthook, commitlint, commitizen) for the Roteirizador Pro monorepo. Apps live under apps/ and have their own package.json each.",
  "engines": {
    "bun": ">=1.3",
    "node": ">=20.9 <21"
  },
  "scripts": {
    "prepare": "lefthook install",
    "commit": "cz",
    "hooks:run": "lefthook run pre-commit"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
